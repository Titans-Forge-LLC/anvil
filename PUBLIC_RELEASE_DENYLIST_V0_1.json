{
  "schema": "anvil-public-release-denylist-v0.1",
  "status": "active",
  "denied_path_globs": [
    "*.db",
    "*.sqlite",
    "*.sqlite3",
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    ".env",
    ".env.*",
    "*.safetensors",
    "*.pt",
    "*.pth",
    "*.ckpt",
    "*.onnx",
    "*.pdf",
    "*.zip",
    "*.tar",
    "*.tar.gz",
    "*.tgz",
    "*retired*shadow*",
    "*held*test*",
    "*SB15A*"
  ],
  "denied_text_fragments": [
    "/Users/",
    "/home/",
    "file:///",
    "BEGIN OPENSSH PRIVATE KEY",
    "BEGIN RSA PRIVATE KEY",
    "BEGIN EC PRIVATE KEY"
  ],
  "note": "This generic denylist supplements hashed private-data fingerprints without publishing internal identifiers or private payloads."
}
